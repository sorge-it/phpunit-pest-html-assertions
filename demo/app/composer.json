{
    "name": "demo/cart",
    "description": "The app the demo of sorge-it/phpunit-pest-html-assertions runs.",
    "license": "MIT",
    "require-dev": {
        "pestphp/pest": "^4.7|^5.0",
        "phpstan/phpstan": "^2.2",
        "sorge-it/phpunit-pest-html-assertions": "*@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "autoload": {
        "files": ["cart.php"]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
